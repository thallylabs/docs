    {
      "tab": "API Reference",
      "api": {
        "source": "openapi.yaml",
        "tagsOrder": [
          "Posts",
          "Comments",
          "Users"
        ],
        "defaultGroup": "General",
        "overrides": {
          "GET /pets": {
            "title": "List pets",
            "description": "Fetch a paginated list of pets.",
            "badge": "Stable"
          },
          "POST /pets": {
            "title": "Create a pet",
            "description": "Add a new pet to the store."
          },
          "GET /pets/{petId}": {
            "title": "Get a pet",
            "description": "Retrieve a single pet by ID."
          },
          "DELETE /pets/{petId}": {
            "title": "Delete a pet",
            "description": "Remove a pet from the store."
          }
        }
      }
